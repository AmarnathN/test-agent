# Framework selection
AI_TEST_FRAMEWORK=playwright

# Browser + runner defaults
AI_TEST_BROWSER=chromium
AI_TEST_HEADLESS=false
AI_TEST_TIMEOUT=60000

# Custom LLM configuration (current project setup)
CUSTOM_LLM_ENDPOINT=https://your-llm-endpoint.com/api
CUSTOM_LLM_API_KEY=your-custom-llm-key
CUSTOM_LLM_MODEL=your-model-name

# OpenAI configuration (optional, only if aiProvider='openai')
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
