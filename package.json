{
  "name": "@ai-test/framework",
  "version": "1.0.0",
  "description": "AI-powered UI test automation framework for CI/CD pipelines",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-test": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "testing",
    "automation",
    "ai",
    "playwright",
    "ci-cd",
    "ui-testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.40.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^17.3.1",
    "glob": "^10.3.10",
    "openai": "^4.20.1",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
